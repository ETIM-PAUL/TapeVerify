{
  "name": "tapeverify",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm -r test",
    "test:testnet": "pnpm --filter @tapeverify/strike-sdk test:testnet && pnpm --filter @tapeverify/api test:testnet && pnpm --filter @tapeverify/workers test:live",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @tapeverify/api db:migrate",
    "db:seed": "pnpm --filter @tapeverify/api db:seed",
    "indexer": "pnpm --filter @tapeverify/workers start",
    "start": "sh scripts/railway-start.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5"
  }
}
