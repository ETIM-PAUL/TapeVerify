{
  "name": "@pit/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude test/testnet.e2e.test.ts",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "test:testnet": "vitest run test/testnet.e2e.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@pit/shared": "workspace:*",
    "@pit/strike-sdk": "workspace:*",
    "@scure/base": "^2.4.0",
    "fastify": "^5.12.7",
    "pg": "^8.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@noble/ed25519": "^2.3.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "viem": "^2.57.7"
  }
}
